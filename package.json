{
  "name": "ts-contractbridge-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/ts-contractbridge",
    "test": "npm test --workspace=packages/ts-contractbridge",
    "test:watch": "npm run test:watch --workspace=packages/ts-contractbridge",
    "typecheck": "npm run typecheck --workspace=packages/ts-contractbridge",
    "dev:viewer": "npm run dev --workspace=apps/pbn-viewer"
  }
}
