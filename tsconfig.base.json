{
  "compilerOptions": {
    // Target: shared across every package in the workspace.
    "target": "ES2022",

    // Library hygiene — the same strictness every package should hold itself to.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,

    // Interop
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
