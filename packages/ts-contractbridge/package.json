{
  "name": "ts-contractbridge",
  "version": "0.1.0",
  "description": "A TypeScript library for contract bridge: cards, hands, deals, auctions, scoring, and reading and writing PBN files",
  "keywords": [
    "bridge",
    "contract-bridge",
    "cards",
    "game",
    "pbn",
    "portable-bridge-notation",
    "bidding",
    "auction"
  ],
  "license": "MIT",
  "author": "Ralph Lipe",
  "homepage": "https://github.com/RalphLipe/ts-contractbridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RalphLipe/ts-contractbridge.git",
    "directory": "packages/ts-contractbridge"
  },
  "bugs": {
    "url": "https://github.com/RalphLipe/ts-contractbridge/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
