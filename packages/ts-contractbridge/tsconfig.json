{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Output
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,          // emit .d.ts files for consumers
    "declarationMap": true,       // source maps for .d.ts (IDE go-to-definition)
    "sourceMap": true,

    // Node 18+ / modern bundlers
    "module": "Node16",
    "moduleResolution": "Node16"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
